    "df_constant = df.copy()\n",
    "gens = df_constant[\"gen_str\"].apply(lambda str : str.split(\"Response:\\n\")[1])\n",
    "\n",
    "for idx in df_constant.index:\n",
    "    gen_str, cif, model_name = df_constant.iloc[idx]\n",
    "\n",
    "    text, gens = gen_str.split(\"Response:\\n\")\n",
    "\n",
    "    lines = [x for x in gens.split(\"\\n\") if len(x) > 0]\n",
    "    lengths = [float(random.random()* 10) for x in lines[0].split(\" \")] \n",
    "    angles = [float(random.random()* 179) for x in lines[1].split(\" \")]\n",
    "    species = [line.split()[0] for line in lines[2:]]\n",
    "\n",
    "    def euclidean_distance(point1, point2):\n",
    "        return ((point2[0] - point1[0]) ** 2 +\n",
    "                (point2[1] - point1[1]) ** 2 +\n",
    "                (point2[2] - point1[2]) ** 2) ** 0.5\n",
    "    \n",
    "    # Initialize list to hold coordinates \n",
    "    coords = []\n",
    "    # Set a threshold for closeness\n",
    "    threshold = 0.1\n",
    "\n",
    "    def is_close_to_any(new_point, existing_points, threshold):\n",
    "        for point in existing_points:\n",
    "            distance = euclidean_distance(new_point, point)\n",
    "            if distance <= threshold:\n",
    "                return True\n",
    "        return False\n",
    "    \n",
    "    for _ in range(len(species)):\n",
    "        while True:  # Loop until a valid point is found\n",
    "            new_point = [random.random(), random.random(), random.random()]\n",
    "        \n",
    "            if not is_close_to_any(new_point, coords, threshold):\n",
    "                #print(f\"Adding new point: {new_point}\")\n",
    "                coords.append(new_point)\n",
    "                break  # Exit the loop if the point is not close\n",
    "            else:\n",
    "                print(f\"New point {new_point} is too close to an existing point. Generating a new one.\")\n",
    "            \n",
    "    #coords = [ [random.random(), random.random(),random.random()] for line in range(len(species))]\n",
    "    structure = Structure(\n",
    "        lattice=Lattice.from_parameters(\n",
