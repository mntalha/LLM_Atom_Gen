    "def parse_fn(gen_str):\n",
    "    lines = [x for x in gen_str.split(\"\\n\") if len(x) > 0]\n",
    "    lengths = [float(x) for x in lines[0].split(\" \")]\n",
    "    angles = [float(x) for x in lines[1].split(\" \")]\n",
    "    species = [line.split()[0] for line in lines[2:]]\n",
    "    coords = [[float(coord) for coord in line.split()[1:]] for line in lines[2:]]\n",
    "    \n",
    "    structure = Structure(\n",
    "        lattice=Lattice.from_parameters(\n",
    "            *(lengths + angles)),\n",
    "        species=species,\n",
    "        coords=coords, \n",
    "        coords_are_cartesian=False,\n",
    "    )\n",
    "    \n",
    "    return structure.to(fmt=\"cif\")"
   ]
  },
